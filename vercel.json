{
  "version": 2,
  "builds": [
    { "src": "transfer-wire.html", "use": "@vercel/static" },
    { "src": "og-image.png", "use": "@vercel/static" },
    { "src": "api/transfers.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/transfers$", "dest": "/api/transfers.js" },
    { "src": "^/og-image.png$", "dest": "/og-image.png" },
    { "src": "^/$", "dest": "/transfer-wire.html" }
  ]
}
